<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,2,0,8" />
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <Setter Property="Margin" Value="0,7,0,3" />
  </Style>

  <Style Selector="RadioButton.tool">
    <Setter Property="MinWidth" Value="74" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="Button.compact">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#6750D8" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Border.status">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="ListBox.series-list">
    <Setter Property="MinHeight" Value="130" />
    <Setter Property="MaxHeight" Value="230" />
  </Style>
</Styles>
